<div class="min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
  <div class="container-fluid">
    <div class="row w-100 justify-content-center">
    <!-- Left Side - Brand & Features -->
    <div class="col-lg-5 col-md-7 mb-4 mb-lg-0">
      <div class="text-white text-center text-lg-start">
        <div class="mb-4">
          <h1 class="display-3 fw-bold mb-3">
            🦄 Learnicorn
          </h1>
          <h2 class="h3 mb-4 text-white-50">Transform Your Learning Journey</h2>
          <p class="lead mb-4">The comprehensive learning management system that connects educators and learners worldwide</p>
        </div>
        
        <!-- Feature Highlights -->
        <div class="row g-4 mb-4">
          <div class="col-sm-6">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-white bg-opacity-20 rounded-circle p-3 me-3">
                <i class="fas fa-graduation-cap text-white h4 mb-0"></i>
              </div>
              <div>
                <h6 class="mb-1 text-white">For Students</h6>
                <small class="text-white-50">Access courses, track progress, complete lessons</small>
              </div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-white bg-opacity-20 rounded-circle p-3 me-3">
                <i class="fas fa-chalkboard-teacher text-white h4 mb-0"></i>
              </div>
              <div>
                <h6 class="mb-1 text-white">For Instructors</h6>
                <small class="text-white-50">Create courses, manage students, track engagement</small>
              </div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-white bg-opacity-20 rounded-circle p-3 me-3">
                <i class="fas fa-chart-line text-white h4 mb-0"></i>
              </div>
              <div>
                <h6 class="mb-1 text-white">Progress Tracking</h6>
                <small class="text-white-50">Monitor learning milestones and achievements</small>
              </div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-white bg-opacity-20 rounded-circle p-3 me-3">
                <i class="fas fa-users text-white h4 mb-0"></i>
              </div>
              <div>
                <h6 class="mb-1 text-white">Community</h6>
                <small class="text-white-50">Connect with peers and instructors</small>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Learning Path Visual -->
        <div class="d-none d-lg-block">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="text-center">
              <div class="bg-success rounded-circle p-2 mb-2" style="width: 40px; height: 40px;">
                <i class="fas fa-play text-white small"></i>
              </div>
              <small class="text-white-50">Start Learning</small>
            </div>
            <div class="flex-grow-1 mx-3">
              <div class="border-top border-white border-opacity-50" style="border-width: 2px !important; border-style: dashed !important;"></div>
            </div>
            <div class="text-center">
              <div class="bg-warning rounded-circle p-2 mb-2" style="width: 40px; height: 40px;">
                <i class="fas fa-book text-white small"></i>
              </div>
              <small class="text-white-50">Complete Courses</small>
            </div>
            <div class="flex-grow-1 mx-3">
              <div class="border-top border-white border-opacity-50" style="border-width: 2px !important; border-style: dashed !important;"></div>
            </div>
            <div class="text-center">
              <div class="bg-info rounded-circle p-2 mb-2" style="width: 40px; height: 40px;">
                <i class="fas fa-trophy text-white small"></i>
              </div>
              <small class="text-white-50">Achieve Goals</small>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Right Side - Login Form -->
    <div class="col-lg-7 col-md-8 d-flex align-items-center justify-content-center p-4">
      <div class="card shadow-lg border-0" style="max-width: 400px; width: 100%;">
        <div class="card-body px-4 py-4" style="background: white;">
          <div class="text-center mb-4">
            <div class="mb-2">
              <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="fas fa-user-circle text-primary h4 mb-0"></i>
              </div>
            </div>
            <h3 class="card-title mb-1 fw-bold">Welcome Back!</h3>
            <p class="text-muted small">Sign in to continue your learning journey</p>
          </div>
          
          <% if flash.any? %>
            <% flash.each do |type, message| %>
              <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %> mb-3" role="alert">
                <i class="fas fa-<%= type == 'notice' ? 'check-circle' : 'exclamation-triangle' %> me-2"></i><%= message %>
              </div>
            <% end %>
          <% end %>
          
          <%= form_with url: login_path, method: :post, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :email, class: "form-label fw-semibold text-dark" do %>
                <i class="fas fa-envelope text-primary me-2"></i>Email Address
              <% end %>
              <%= form.email_field :email, class: "form-control form-control-lg border-2 rounded-3 shadow-sm", required: true, placeholder: "Enter your email", style: "padding: 0.6rem 1rem; border-color: #e9ecef;" %>
            </div>
            
            <div class="mb-3">
              <%= form.label :password, class: "form-label fw-semibold text-dark" do %>
                <i class="fas fa-lock text-primary me-2"></i>Password
              <% end %>
              <%= form.password_field :password, class: "form-control form-control-lg border-2 rounded-3 shadow-sm", required: true, placeholder: "Enter your password", style: "padding: 0.6rem 1rem; border-color: #e9ecef;" %>
            </div>
            
            <div class="d-grid mb-3">
              <%= form.submit "Sign In to Learnicorn", class: "btn btn-primary btn-lg rounded-3 shadow-sm", style: "padding: 0.6rem 1.5rem; font-weight: 600;" %>
            </div>
          <% end %>
          
          <div class="text-center">
            <p class="text-muted mb-2">New to Learnicorn?</p>
            <%= link_to "Create your account", signup_path, class: "fw-semibold text-decoration-none btn btn-outline-primary rounded-3 px-4 py-2" %>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>
</div>

<!-- Add Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">