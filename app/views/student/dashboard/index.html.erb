<% content_for :title, "Student Dashboard" %>

<div class="row">
  <div class="col-12">
    <h1>Student Dashboard</h1>
    <p class="text-muted">Welcome back, <%= current_user.name %>!</p>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-3">
    <div class="card text-white bg-primary">
      <div class="card-body">
        <h5 class="card-title">Enrolled Courses</h5>
        <h2><%= @progress_stats[:total_courses] %></h2>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-white bg-success">
      <div class="card-body">
        <h5 class="card-title">Total Lessons</h5>
        <h2><%= @progress_stats[:total_lessons] %></h2>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-white bg-info">
      <div class="card-body">
        <h5 class="card-title">Completed Lessons</h5>
        <h2><%= @progress_stats[:completed_lessons] %></h2>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card text-white bg-warning">
      <div class="card-body">
        <h5 class="card-title">Overall Progress</h5>
        <h2><%= @progress_stats[:overall_progress] %>%</h2>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">My Courses</h5>
        <%= link_to "View All", student_courses_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
      <div class="card-body">
        <% if @enrolled_courses.any? %>
          <% @enrolled_courses.each do |course| %>
            <div class="mb-3">
              <h6><%= link_to course.title, student_course_path(course), class: "text-decoration-none" %></h6>
              <small class="text-muted">by <%= course.instructor.name %></small>
              <div class="progress mt-2">
                <div class="progress-bar" role="progressbar" style="width: <%= course.completion_percentage_for(current_user) %>%">
                  <%= course.completion_percentage_for(current_user) %>%
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted">You haven't enrolled in any courses yet.</p>
          <%= link_to "Browse Courses", courses_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Available Courses</h5>
        <%= link_to "Browse All", courses_path, class: "btn btn-sm btn-outline-primary" %>
      </div>
      <div class="card-body">
        <% if @available_courses.any? %>
          <% @available_courses.first(3).each do |course| %>
            <div class="mb-3">
              <h6><%= link_to course.title, course_path(course), class: "text-decoration-none" %></h6>
              <small class="text-muted">by <%= course.instructor.name %> • <%= course.duration %> hours</small>
              <p class="small text-truncate"><%= course.description %></p>
              <%= link_to "View Details", course_path(course), class: "btn btn-sm btn-outline-primary" %>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted">No new courses available.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @recent_completions.any? %>
  <div class="row mt-4">
    <div class="col-12">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Recent Completions</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-sm">
              <thead>
                <tr>
                  <th>Lesson</th>
                  <th>Course</th>
                  <th>Completed</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_completions.each do |completion| %>
                  <tr>
                    <td><%= completion.lesson.title %></td>
                    <td><%= completion.lesson.course.title %></td>
                    <td><%= completion.completed_at.strftime("%m/%d/%Y") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>