<% content_for :title, @lesson.title %>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><%= link_to "My Courses", student_courses_path %></li>
            <li class="breadcrumb-item"><%= link_to @course.title, student_course_path(@course) %></li>
            <li class="breadcrumb-item active" aria-current="page"><%= @lesson.title %></li>
          </ol>
        </nav>
      </div>
      <div class="card-body">
        <h3><%= @lesson.title %></h3>
        <p class="text-muted">Lesson <%= @lesson.position %> of <%= @course.lessons.count %></p>
        
        <% if @lesson.has_content_blocks? %>
          <div class="lesson-content">
            <% @lesson.ordered_content_blocks.each do |content_block| %>
              <%= render "content_blocks/content_block", content_block: content_block %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-5 text-muted">
            <i class="fas fa-book-open fa-2x mb-3"></i>
            <p>No content has been added to this lesson yet.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Assignments Section -->
    <% if @lesson.has_assignments? %>
      <div class="card mt-4">
        <div class="card-header">
          <div class="d-flex justify-content-between align-items-center">
            <h5>
              <i class="fas fa-clipboard-list"></i> Assignments
            </h5>
            <%= link_to "View All Assignments", 
                        student_course_lesson_assignments_path(@course, @lesson), 
                        class: "btn btn-primary btn-sm" %>
          </div>
        </div>
        <div class="card-body">
          <% @lesson.published_assignments.limit(3).each do |assignment| %>
            <% user_submission = assignment.assignment_submissions.find_by(user: current_user) %>
            <div class="assignment-item mb-3 p-3 border rounded">
              <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                  <h6 class="mb-1">
                    <i class="fas fa-<%= assignment.quiz? ? 'question-circle text-primary' : assignment.coding? ? 'code text-success' : assignment.essay? ? 'edit text-warning' : 'tasks text-info' %>"></i>
                    <%= assignment.title %>
                  </h6>
                  <% if assignment.description.present? %>
                    <p class="text-muted small mb-2"><%= truncate(assignment.description, length: 100) %></p>
                  <% end %>
                  <div class="assignment-meta">
                    <small class="text-muted me-3">
                      <i class="fas fa-star"></i> <%= assignment.max_score %> points
                    </small>
                    <small class="text-muted me-3">
                      <i class="fas fa-question"></i> <%= assignment.total_questions %> questions
                    </small>
                    <% if assignment.due_date.present? %>
                      <small class="text-muted">
                        <i class="fas fa-clock"></i> Due <%= assignment.due_date.strftime("%b %d") %>
                      </small>
                    <% end %>
                  </div>
                </div>
                <div class="assignment-actions">
                  <% if user_submission&.submitted? %>
                    <div class="text-end">
                      <span class="badge bg-success mb-1">
                        <i class="fas fa-check"></i> Completed
                      </span>
                      <br>
                      <% if user_submission.score.present? %>
                        <small class="text-success">
                          <%= user_submission.score %>/<%= assignment.max_score %>
                        </small>
                      <% end %>
                    </div>
                  <% elsif user_submission&.draft? %>
                    <div class="text-end">
                      <span class="badge bg-warning mb-1">
                        <i class="fas fa-clock"></i> In Progress
                      </span>
                      <br>
                      <%= link_to "Continue", 
                                  take_student_course_lesson_assignment_path(@course, @lesson, assignment), 
                                  class: "btn btn-warning btn-sm" %>
                    </div>
                  <% elsif assignment.due_date.present? && assignment.due_date < Time.current %>
                    <div class="text-end">
                      <span class="badge bg-danger mb-1">
                        <i class="fas fa-exclamation-triangle"></i> Overdue
                      </span>
                    </div>
                  <% else %>
                    <div class="text-end">
                      <%= link_to "Start Assignment", 
                                  take_student_course_lesson_assignment_path(@course, @lesson, assignment), 
                                  class: "btn btn-primary btn-sm" %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <% if @lesson.published_assignments.count > 3 %>
            <div class="text-center">
              <%= link_to "View All #{@lesson.published_assignments.count} Assignments", 
                          student_course_lesson_assignments_path(@course, @lesson), 
                          class: "btn btn-outline-primary btn-sm" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="card mt-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <% if @previous_lesson %>
              <%= link_to "← Previous: #{@previous_lesson.title}", student_course_lesson_path(@course, @previous_lesson), class: "btn btn-outline-secondary" %>
            <% end %>
          </div>
          <div class="text-center">
            <% if @is_completed %>
              <span class="badge bg-success fs-6">✓ Completed</span>
            <% else %>
              <%= form_with url: complete_course_lesson_path(@course, @lesson), method: :post, local: true, class: "d-inline" do |form| %>
                <%= form.submit "Mark as Complete", class: "btn btn-success", 
                                confirm: "Mark this lesson as completed?",
                                data: { disable_with: "<i class='fas fa-spinner fa-spin'></i> Completing..." } %>
              <% end %>
            <% end %>
          </div>
          <div>
            <% if @next_lesson %>
              <%= link_to "Next: #{@next_lesson.title} →", student_course_lesson_path(@course, @next_lesson), class: "btn btn-primary" %>
            <% else %>
              <%= link_to "Back to Course", student_course_path(@course), class: "btn btn-outline-primary" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h6>Course Progress</h6>
      </div>
      <div class="card-body">
        <div class="progress mb-3">
          <div class="progress-bar" role="progressbar" style="width: <%= @course.completion_percentage_for(current_user) %>%">
            <%= @course.completion_percentage_for(current_user) %>%
          </div>
        </div>
        <p class="text-center text-muted">
          <%= current_user.lesson_completions.joins(:lesson).where(lessons: { course: @course }).count %> of <%= @course.lessons.count %> lessons completed
        </p>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">
        <h6>All Lessons</h6>
      </div>
      <div class="card-body">
        <% @course.lessons.ordered.each do |lesson| %>
          <div class="d-flex align-items-center mb-2">
            <div class="me-2">
              <% if lesson.completed_by?(current_user) %>
                <span class="badge bg-success">✓</span>
              <% elsif lesson == @lesson %>
                <span class="badge bg-primary">●</span>
              <% else %>
                <span class="badge bg-secondary"><%= lesson.position %></span>
              <% end %>
            </div>
            <div class="flex-grow-1">
              <% if lesson == @lesson %>
                <strong><%= lesson.title %></strong>
              <% else %>
                <%= link_to lesson.title, student_course_lesson_path(@course, lesson), class: "text-decoration-none small" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>