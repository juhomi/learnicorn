<% content_for :title, "Create New Course" %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h3>Create New Course</h3>
      </div>
      <div class="card-body">
        <%= form_with model: @course, url: admin_courses_path, local: true do |form| %>
          <% if @course.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @course.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :title, class: "form-label" %>
            <%= form.text_field :title, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :description, class: "form-label" %>
            <%= form.text_area :description, class: "form-control", rows: 4, required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :duration, "Duration (hours)", class: "form-label" %>
            <%= form.number_field :duration, class: "form-control", min: 1, required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :instructor_id, "Instructor", class: "form-label" %>
            <%= form.select :instructor_id, options_from_collection_for_select(@instructors, :id, :name, @course.instructor_id), 
                { prompt: 'Select instructor' }, { class: "form-select", required: true } %>
          </div>

          <div class="mb-3">
            <div class="form-check">
              <%= form.check_box :published, class: "form-check-input" %>
              <%= form.label :published, "Publish this course", class: "form-check-label" %>
              <small class="form-text text-muted">Published courses are visible to students.</small>
            </div>
          </div>

          <div class="d-flex justify-content-between">
            <%= link_to "Cancel", admin_courses_path, class: "btn btn-secondary" %>
            <%= form.submit "Create Course", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>