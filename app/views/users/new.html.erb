<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="text-center mb-4">
      <h1 class="display-4 fw-bold text-primary">Learnicorn</h1>
      <p class="text-muted mb-2">Learning Management System</p>
      <p class="text-muted small">Connect instructors and students • Track progress • Manage courses and lessons</p>
    </div>
    <!-- Beta Invitation-Only Notice -->
    <div class="alert alert-info border-0 shadow-sm mb-4" style="background: linear-gradient(45deg, #667eea, #764ba2); color: white;">
      <div class="text-center">
        <h4 class="fw-bold mb-2">
          <i class="fas fa-flask me-2"></i>Learnicorn Beta
        </h4>
        <p class="mb-2 fw-semibold">We're currently in Beta!</p>
        <p class="mb-0 small">New accounts are available by invitation only. If you have an invitation code or would like to request access, please contact our team.</p>
      </div>
    </div>

    <div class="card opacity-75">
      <div class="card-header bg-light">
        <h3 class="text-muted">Sign Up <small>(Invitation Only)</small></h3>
      </div>
      <div class="card-body">
        <%= form_with model: @user, url: signup_path, local: true, data: { turbo: false } do |form| %>
          <% if @user.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          
          <div class="mb-3">
            <%= form.label :name, class: "form-label" %>
            <%= form.text_field :name, class: "form-control", required: true, disabled: true %>
          </div>
          
          <div class="mb-3">
            <%= form.label :email, class: "form-label" %>
            <%= form.email_field :email, class: "form-control", required: true, disabled: true %>
          </div>
          
          <div class="mb-3">
            <%= form.label :password, class: "form-label" %>
            <%= form.password_field :password, class: "form-control", required: true, disabled: true %>
          </div>
          
          <div class="mb-3">
            <%= form.label :password_confirmation, class: "form-label" %>
            <%= form.password_field :password_confirmation, class: "form-control", required: true, disabled: true %>
          </div>
          
          <div class="mb-3">
            <%= form.label :role, class: "form-label" %>
            <%= form.select :role, options_for_select([
              ['Student', 'student'],
              ['Instructor', 'instructor']
            ], @user.role), { prompt: 'Select your role' }, { class: "form-select", required: true, disabled: true } %>
          </div>
          
          <div class="d-grid">
            <%= form.submit "Sign Up Currently Unavailable", class: "btn btn-secondary", disabled: true %>
          </div>
        <% end %>
        
        <div class="mt-3 text-center">
          <%= link_to "Already have an account? Login", login_path %>
        </div>
      </div>
    </div>
  </div>
</div>