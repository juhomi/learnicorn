<!-- Hero Section -->
<section class="hero-section min-vh-100 d-flex align-items-center position-relative overflow-hidden" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
  <!-- Animated Background Elements -->
  <div class="position-absolute top-0 start-0 w-100 h-100">
    <div class="floating-element position-absolute" style="top: 10%; left: 10%; animation: float 6s ease-in-out infinite;">
      <i class="fas fa-graduation-cap text-white opacity-25 display-1"></i>
    </div>
    <div class="floating-element position-absolute" style="top: 20%; right: 15%; animation: float 8s ease-in-out infinite 2s;">
      <i class="fas fa-book text-white opacity-25 display-2"></i>
    </div>
    <div class="floating-element position-absolute" style="bottom: 30%; left: 20%; animation: float 7s ease-in-out infinite 4s;">
      <i class="fas fa-lightbulb text-white opacity-25 display-3"></i>
    </div>
  </div>
  
  <div class="container position-relative">
    <div class="row align-items-center">
      <div class="col-lg-6 text-white">
        <h1 class="display-1 fw-bold mb-4">
          🦄 Learnicorn
          <span class="d-block display-4 text-warning">Learn Without Limits</span>
        </h1>
        <p class="lead mb-4 fs-3">
          The most intuitive Learning Management System that transforms how educators teach and students learn
        </p>
        <p class="mb-5 fs-5 text-white-75">
          Join thousands of educators and learners worldwide in creating meaningful educational experiences
        </p>
        
        <!-- CTA Buttons -->
        <div class="d-flex flex-column flex-sm-row gap-3 mb-5">
          <%= link_to "Start Learning Today", signup_path, class: "btn btn-warning btn-lg px-5 py-3 fw-bold" %>
          <%= link_to "Sign In", login_path, class: "btn btn-outline-light btn-lg px-5 py-3 fw-bold" %>
          <%= link_to "Learn More", marketing_path, class: "btn btn-outline-warning btn-lg px-5 py-3 fw-bold" %>
        </div>
        
        <!-- Stats -->
        <div class="row g-4 mt-4">
          <div class="col-4 text-center">
            <div class="h2 fw-bold text-warning mb-1"><%= @total_courses %>+</div>
            <small class="text-white-75">Active Courses</small>
          </div>
          <div class="col-4 text-center">
            <div class="h2 fw-bold text-warning mb-1"><%= @total_students %>+</div>
            <small class="text-white-75">Happy Students</small>
          </div>
          <div class="col-4 text-center">
            <div class="h2 fw-bold text-warning mb-1"><%= @total_instructors %>+</div>
            <small class="text-white-75">Expert Instructors</small>
          </div>
        </div>
      </div>
      
      <div class="col-lg-6 text-center">
        <div class="position-relative">
          <!-- Mock Dashboard Preview -->
          <div class="bg-white rounded-3 shadow-lg p-4 mb-4" style="transform: rotate(-5deg);">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-primary rounded-circle p-2 me-3">
                <i class="fas fa-chart-line text-white"></i>
              </div>
              <div>
                <h6 class="mb-0">Learning Progress</h6>
                <small class="text-muted">Track your achievements</small>
              </div>
            </div>
            <div class="progress mb-2" style="height: 10px;">
              <div class="progress-bar bg-success" style="width: 75%"></div>
            </div>
            <small class="text-muted">75% Complete - Keep going!</small>
          </div>
          
          <div class="bg-white rounded-3 shadow-lg p-4" style="transform: rotate(5deg); margin-top: -20px;">
            <div class="d-flex align-items-center mb-3">
              <div class="bg-success rounded-circle p-2 me-3">
                <i class="fas fa-trophy text-white"></i>
              </div>
              <div>
                <h6 class="mb-0">Achievement Unlocked!</h6>
                <small class="text-muted">Course completion badge</small>
              </div>
            </div>
            <div class="text-center">
              <i class="fas fa-medal text-warning h1"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

