<% content_for :title, "Instructor Dashboard" %>

<div class="row">
  <div class="col-12">
    <h1>Instructor Dashboard</h1>
    <p class="text-muted">Welcome back, <%= current_user.name %>!</p>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-4">
    <div class="card text-white bg-primary">
      <div class="card-body">
        <h5 class="card-title">My Courses</h5>
        <h2><%= @my_courses.count %></h2>
        <small>Total courses created</small>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-white bg-success">
      <div class="card-body">
        <h5 class="card-title">Total Students</h5>
        <h2><%= @total_students %></h2>
        <small>Students enrolled in your courses</small>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card text-white bg-info">
      <div class="card-body">
        <h5 class="card-title">Total Lessons</h5>
        <h2><%= @total_lessons %></h2>
        <small>Lessons you've created</small>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">My Courses</h5>
        <%= link_to "Create New Course", new_instructor_course_path, class: "btn btn-primary btn-sm" %>
      </div>
      <div class="card-body">
        <% if @my_courses.any? %>
          <% @my_courses.each do |course| %>
            <div class="row mb-3">
              <div class="col-md-8">
                <h6><%= link_to course.title, instructor_course_path(course), class: "text-decoration-none" %></h6>
                <p class="text-muted mb-1"><%= truncate(course.description, length: 100) %></p>
                <small class="text-muted">
                  <%= course.lessons.count %> lessons • <%= course.students.count %> students
                  <% if course.published? %>
                    <span class="badge bg-success">Published</span>
                  <% else %>
                    <span class="badge bg-secondary">Draft</span>
                  <% end %>
                </small>
              </div>
              <div class="col-md-4 text-end">
                <%= link_to "Edit", edit_instructor_course_path(course), class: "btn btn-sm btn-outline-primary" %>
                <%= link_to "Lessons", instructor_course_lessons_path(course), class: "btn btn-sm btn-outline-secondary" %>
              </div>
            </div>
            <hr>
          <% end %>
        <% else %>
          <div class="text-center">
            <h6>No courses created yet</h6>
            <p class="text-muted">Create your first course to get started!</p>
            <%= link_to "Create Course", new_instructor_course_path, class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h6>Recent Enrollments</h6>
      </div>
      <div class="card-body">
        <% if @recent_enrollments.any? %>
          <% @recent_enrollments.each do |enrollment| %>
            <div class="mb-3">
              <strong><%= enrollment.user.name %></strong>
              <br>
              <small class="text-muted">
                enrolled in <%= enrollment.course.title %>
                <br>
                <%= enrollment.enrolled_at.strftime("%m/%d/%Y") %>
              </small>
            </div>
          <% end %>
        <% else %>
          <p class="text-muted">No recent enrollments.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>