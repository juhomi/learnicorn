<% content_for :title, "Edit Lesson" %>

<div class="row">
  <div class="col-12">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to "My Courses", instructor_courses_path %></li>
        <li class="breadcrumb-item"><%= link_to @course.title, instructor_course_path(@course) %></li>
        <li class="breadcrumb-item"><%= link_to "Lessons", instructor_course_lessons_path(@course) %></li>
        <li class="breadcrumb-item"><%= link_to @lesson.title, instructor_course_lesson_path(@course, @lesson) %></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
      </ol>
    </nav>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <!-- Lesson Basic Info -->
    <div class="card">
      <div class="card-header">
        <h4>Edit Lesson: <%= @lesson.title %></h4>
      </div>
      <div class="card-body">
        <%= form_with model: [@course, @lesson], url: instructor_course_lesson_path(@course, @lesson), local: true do |form| %>
          <% if @lesson.errors.any? %>
            <div class="alert alert-danger">
              <h6><%= pluralize(@lesson.errors.count, "error") %> prohibited this lesson from being saved:</h6>
              <ul class="mb-0">
                <% @lesson.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="row">
            <div class="col-md-8">
              <div class="mb-3">
                <%= form.label :title, class: "form-label" %>
                <%= form.text_field :title, class: "form-control", required: true %>
              </div>
            </div>
            <div class="col-md-4">
              <div class="mb-3">
                <%= form.label :position, "Lesson Position", class: "form-label" %>
                <%= form.number_field :position, class: "form-control", min: 1, required: true %>
                <div class="form-text">Order in course</div>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-between">
            <%= link_to "Cancel", instructor_course_lesson_path(@course, @lesson), class: "btn btn-secondary" %>
            <div>
              <%= form.submit "Update Lesson", class: "btn btn-primary" %>
              <%= link_to "Delete Lesson", instructor_course_lesson_path(@course, @lesson), 
                          method: :delete, 
                          confirm: "Are you sure? This will delete the lesson and all its content blocks.", 
                          class: "btn btn-danger" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Content Blocks Editor -->
    <div class="card mt-4">
      <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
          <h5>Lesson Content</h5>
          <div class="dropdown">
            <button class="btn btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown">
              <i class="fas fa-plus"></i> Add Content Block
            </button>
            <ul class="dropdown-menu">
              <li><%= link_to new_instructor_course_lesson_content_block_path(@course, @lesson, block_type: 'text'), 
                              class: "dropdown-item",
                              data: { turbo_frame: "content_block_form" } do %>
                      <i class="fas fa-font text-primary"></i> Add Text Block
                  <% end %></li>
              <li><%= link_to new_instructor_course_lesson_content_block_path(@course, @lesson, block_type: 'image'), 
                              class: "dropdown-item",
                              data: { turbo_frame: "content_block_form" } do %>
                      <i class="fas fa-image text-success"></i> Add Image Block
                  <% end %></li>
              <li><%= link_to new_instructor_course_lesson_content_block_path(@course, @lesson, block_type: 'video'), 
                              class: "dropdown-item",
                              data: { turbo_frame: "content_block_form" } do %>
                      <i class="fas fa-video text-warning"></i> Add Video Block
                  <% end %></li>
            </ul>
          </div>
        </div>
        <p class="text-muted small mb-0 mt-2">
          <i class="fas fa-info-circle"></i> 
          Create rich content by combining text, images, and videos. Drag blocks to reorder them.
        </p>
      </div>
      <div class="card-body">
        <%= turbo_frame_tag "content_block_form" %>

        <div id="content-blocks-container" 
             data-controller="content-blocks-editor"
             data-content-blocks-editor-reorder-url-value="<%= instructor_course_lesson_content_blocks_path(@course, @lesson) %>">
          <% if @lesson.has_content_blocks? %>
            <% @lesson.ordered_content_blocks.each do |content_block| %>
              <%= render "instructor/content_blocks/content_block", content_block: content_block %>
            <% end %>
          <% else %>
            <div class="text-center py-5 text-muted">
              <i class="fas fa-plus-circle fa-3x mb-3"></i>
              <h6>No content blocks yet</h6>
              <p>Add your first content block using the button above to start creating your lesson.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Sidebar -->
  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h6>Lesson Actions</h6>
      </div>
      <div class="card-body">
        <%= link_to "View Lesson", instructor_course_lesson_path(@course, @lesson), 
                    class: "btn btn-outline-primary w-100 mb-2" %>
        <%= link_to "Preview as Student", course_lesson_path(@course, @lesson), 
                    class: "btn btn-outline-info w-100 mb-2",
                    target: "_blank" %>
        <%= link_to "Back to Lessons", instructor_course_lessons_path(@course), 
                    class: "btn btn-secondary w-100" %>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">
        <h6>Lesson Info</h6>
      </div>
      <div class="card-body">
        <p><strong>Course:</strong> <%= @course.title %></p>
        <p><strong>Position:</strong> <%= @lesson.position %> of <%= @course.lessons.count %></p>
        <span id="content-blocks-info">
          <p><strong>Content Blocks:</strong> <%= @lesson.content_blocks.count %></p>
        </span>
        <p><strong>Created:</strong> <%= @lesson.created_at.strftime("%B %d, %Y") %></p>
        <p><strong>Last Updated:</strong> <%= @lesson.updated_at.strftime("%B %d, %Y") %></p>
      </div>
    </div>
  </div>
</div>