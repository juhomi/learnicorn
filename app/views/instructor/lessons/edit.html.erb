<% content_for :title, "Edit Lesson" %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h3>Edit Lesson</h3>
      </div>
      <div class="card-body">
        <%= form_with model: [@course, @lesson], url: instructor_course_lesson_path(@course, @lesson), local: true do |form| %>
          <% if @lesson.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @lesson.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :title, class: "form-label" %>
            <%= form.text_field :title, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :content, class: "form-label" %>
            <%= form.text_area :content, class: "form-control", rows: 8, required: true %>
            <div class="form-text">Write the lesson content here. This will be displayed to students.</div>
          </div>

          <div class="mb-3">
            <%= form.label :video_url, "Video URL (optional)", class: "form-label" %>
            <%= form.url_field :video_url, class: "form-control" %>
            <div class="form-text">Add a video URL to embed in the lesson (YouTube, Vimeo, etc.)</div>
          </div>

          <div class="mb-3">
            <%= form.label :position, "Lesson Position", class: "form-label" %>
            <%= form.number_field :position, class: "form-control", min: 1, required: true %>
            <div class="form-text">The order of this lesson in the course (1 = first lesson)</div>
          </div>

          <div class="d-flex justify-content-between">
            <%= link_to "Cancel", instructor_course_lesson_path(@course, @lesson), class: "btn btn-secondary" %>
            <div>
              <%= form.submit "Update Lesson", class: "btn btn-primary" %>
              <%= link_to "Delete Lesson", instructor_course_lesson_path(@course, @lesson), method: :delete, 
                  confirm: "Are you sure?", class: "btn btn-danger" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>