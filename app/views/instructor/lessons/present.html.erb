<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @lesson.title %> - Presentation Mode</title>
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  
  <style>
    /* Presentation Mode Styles */
    body {
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      color: #ffffff;
      overflow: hidden;
    }

    .presentation-container {
      height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* Header */
    .presentation-header {
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(10px);
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      z-index: 1000;
    }

    .lesson-title {
      font-size: 1.5rem;
      font-weight: 600;
      margin: 0;
      color: #ffffff;
    }

    .slide-counter {
      font-size: 1rem;
      color: #b0b0b0;
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .progress-bar {
      width: 200px;
      height: 4px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 2px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #4CAF50, #45a049);
      width: <%= (@current_slide.to_f / @total_slides * 100).round(2) %>%;
      transition: width 0.3s ease;
    }

    /* Main Content Area */
    .presentation-content {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 40px;
      position: relative;
      overflow-y: auto;
      min-height: 0; /* Important for flexbox scrolling */
    }

    .slide {
      max-width: 900px;
      width: 100%;
      text-align: left;
      animation: slideIn 0.5s ease-out;
      min-height: fit-content;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    /* Content Block Styles */
    .content-block {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 40px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .content-block h1, .content-block h2, .content-block h3 {
      color: #ffffff;
      margin-bottom: 20px;
      line-height: 1.3;
    }

    .content-block h1 { font-size: 3rem; font-weight: 700; }
    .content-block h2 { font-size: 2.5rem; font-weight: 600; }
    .content-block h3 { font-size: 2rem; font-weight: 500; }

    .content-block p {
      font-size: 1.4rem;
      line-height: 1.6;
      color: #e0e0e0;
      margin-bottom: 15px;
    }

    .content-block ul, .content-block ol {
      font-size: 1.3rem;
      line-height: 1.7;
      color: #e0e0e0;
      padding-left: 30px;
    }

    .content-block li {
      margin-bottom: 10px;
    }

    /* Image Content */
    .image-content {
      text-align: center;
    }

    .image-content img {
      max-width: 100%;
      max-height: 60vh;
      border-radius: 15px;
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
    }

    .image-content .caption {
      font-size: 1.2rem;
      color: #b0b0b0;
      margin-top: 20px;
      font-style: italic;
    }

    /* Video Content */
    .video-content {
      text-align: center;
    }

    .video-content iframe {
      width: 800px;
      height: 450px;
      border-radius: 15px;
      max-width: 100%;
    }

    /* Code Content */
    .code-content {
      background: rgba(0, 0, 0, 0.4);
      border-radius: 15px;
      padding: 30px;
      font-family: 'Fira Code', 'Monaco', 'Consolas', monospace;
    }

    .code-content pre {
      font-size: 1.1rem;
      line-height: 1.5;
      color: #f8f8f2;
      margin: 0;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    /* Navigation */
    .nav-button {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #ffffff;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      cursor: pointer;
      transition: all 0.3s ease;
      z-index: 100;
    }

    .nav-button:hover {
      background: rgba(255, 255, 255, 0.3);
      transform: translateY(-50%) scale(1.1);
    }

    .nav-button:disabled {
      opacity: 0.3;
      cursor: not-allowed;
      pointer-events: none;
    }

    .nav-prev {
      left: 30px;
    }

    .nav-next {
      right: 30px;
    }

    /* Slide Overview Panel */
    .slide-overview {
      position: fixed;
      left: -300px;
      top: 0;
      width: 280px;
      height: 100vh;
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(15px);
      border-right: 1px solid rgba(255, 255, 255, 0.2);
      transition: left 0.3s ease;
      z-index: 2000;
      overflow-y: auto;
      padding: 20px;
    }

    .slide-overview.open {
      left: 0;
    }

    .slide-overview h4 {
      color: #fff;
      font-size: 1.1rem;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .lesson-section {
      margin-bottom: 25px;
    }

    .lesson-header {
      font-size: 0.9rem;
      color: #4CAF50;
      font-weight: 600;
      margin-bottom: 10px;
      padding: 8px 0;
      border-bottom: 1px solid rgba(76, 175, 80, 0.3);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .lesson-header small {
      color: #888;
      font-weight: 400;
      margin-left: auto;
    }

    .slide-thumbnail {
      background: rgba(255, 255, 255, 0.1);
      border: 2px solid transparent;
      border-radius: 10px;
      padding: 15px;
      margin-bottom: 15px;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: block;
      color: inherit;
    }

    .slide-thumbnail:hover {
      background: rgba(255, 255, 255, 0.2);
      color: inherit;
      text-decoration: none;
    }

    .slide-thumbnail.active {
      border-color: #4CAF50;
      background: rgba(76, 175, 80, 0.2);
    }

    .slide-thumbnail .slide-number {
      font-size: 0.8rem;
      color: #4CAF50;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .slide-thumbnail .slide-preview {
      font-size: 0.9rem;
      color: #e0e0e0;
      line-height: 1.4;
      height: 3.6em;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
    }

    .overview-toggle {
      position: fixed;
      left: 20px;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(0, 0, 0, 0.8);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.3);
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s ease;
      z-index: 1500;
      backdrop-filter: blur(10px);
    }

    .overview-toggle:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    /* Footer Controls */
    .presentation-footer {
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(10px);
      padding: 15px 30px;
      display: flex;
      justify-content: center;
      gap: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .control-button {
      background: rgba(255, 255, 255, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #ffffff;
      padding: 10px 20px;
      border-radius: 25px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
    }

    .control-button:hover {
      background: rgba(255, 255, 255, 0.3);
      color: #ffffff;
      text-decoration: none;
    }

    /* Empty State */
    .empty-lesson {
      text-align: center;
      padding: 60px 40px;
    }

    .empty-lesson i {
      font-size: 4rem;
      color: #666;
      margin-bottom: 20px;
    }

    .empty-lesson h3 {
      color: #999;
      margin-bottom: 15px;
    }

    .empty-lesson p {
      color: #777;
      font-size: 1.1rem;
    }

    /* Custom Scrollbar */
    .presentation-content::-webkit-scrollbar {
      width: 8px;
    }

    .presentation-content::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 4px;
    }

    .presentation-content::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.3);
      border-radius: 4px;
    }

    .presentation-content::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.5);
    }

    /* Firefox scrollbar */
    .presentation-content {
      scrollbar-width: thin;
      scrollbar-color: rgba(255, 255, 255, 0.3) rgba(255, 255, 255, 0.1);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .presentation-header {
        padding: 10px 20px;
      }
      
      .lesson-title {
        font-size: 1.2rem;
      }
      
      .presentation-content {
        padding: 20px;
      }
      
      .content-block {
        padding: 30px 25px;
      }
      
      .content-block h1 { font-size: 2.5rem; }
      .content-block h2 { font-size: 2rem; }
      .content-block h3 { font-size: 1.7rem; }
      .content-block p { font-size: 1.2rem; }
      
      .nav-button {
        width: 50px;
        height: 50px;
        font-size: 1.3rem;
      }
      
      .video-content iframe {
        width: 100%;
        height: 250px;
      }
    }
  </style>
</head>

<body>
  <!-- Slide Overview Panel -->
  <% if @total_slides > 1 %>
    <div class="slide-overview" id="slideOverview">
      <h4><i class="fas fa-list"></i> Course Slides (<%= @total_slides %>)</h4>
      
      <% @lesson_boundaries.each do |boundary| %>
        <div class="lesson-section" style="margin-bottom: 25px;">
          <div class="lesson-header" style="font-size: 0.9rem; color: #4CAF50; font-weight: 600; margin-bottom: 10px; padding: 8px 0; border-bottom: 1px solid rgba(76, 175, 80, 0.3);">
            <i class="fas fa-book-open"></i> <%= boundary[:lesson].title %>
            <small style="color: #888; font-weight: 400; margin-left: 8px;">(<%= boundary[:slide_count] %> slides)</small>
          </div>
          
          <% (boundary[:start_index]..boundary[:end_index]).each do |slide_index| %>
            <% slide_data = @course_slides[slide_index] %>
            <% content_block = slide_data[:content_block] %>
            <%= link_to present_instructor_course_lesson_path(@course, @current_lesson, slide: slide_index + 1),
                        class: "slide-thumbnail #{'active' if @current_slide == slide_index + 1}" do %>
              <div class="slide-number">
                Slide <%= slide_index + 1 %>
                <small style="color: #666; font-size: 0.7em; display: block;">(<%= slide_data[:lesson_slide_number] %> in lesson)</small>
              </div>
              <div class="slide-preview">
                <% case content_block.block_type %>
                <% when 'text' %>
                  <%= truncate(strip_tags(content_block.content.to_s), length: 80) if content_block.content.present? %>
                <% when 'image' %>
                  <i class="fas fa-image"></i> <%= content_block.alt_text.presence || 'Image slide' %>
                <% when 'video' %>
                  <i class="fas fa-video"></i> <%= content_block.alt_text.presence || 'Video slide' %>
                <% else %>
                  <%= content_block.block_type.humanize %> content
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Overview Toggle Button -->
    <button class="overview-toggle" id="overviewToggle" title="Toggle slide overview">
      <i class="fas fa-list"></i>
    </button>
  <% end %>

  <div class="presentation-container">
    <!-- Header -->
    <div class="presentation-header">
      <div class="course-info">
        <h1 class="lesson-title">
          <%= @current_lesson.title %>
          <small style="font-size: 0.6em; color: #b0b0b0; font-weight: 400; display: block; margin-top: 5px;">
            Lesson <%= @current_lesson.position %> of <%= @all_lessons.count %> • <%= @course.title %>
          </small>
        </h1>
        <div class="lesson-progress" style="font-size: 0.8em; color: #888; margin-top: 8px;">
          <i class="fas fa-presentation"></i> 
          Slide <%= @lesson_slide_number %> of <%= @current_lesson_boundary[:slide_count] %> in this lesson
        </div>
      </div>
      
      <div class="slide-counter">
        <div class="global-progress">
          <span>Course Progress: <%= @current_slide %> / <%= @total_slides %></span>
          <div class="progress-bar">
            <div class="progress-fill"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="presentation-content">
      <% if @total_slides > 0 && @current_content_block %>
        <!-- Navigation Buttons -->
        <% if @has_previous %>
          <%= link_to present_instructor_course_lesson_path(@course, @current_lesson, slide: @current_slide - 1), 
                      class: "nav-button nav-prev", 
                      title: "Previous slide" do %>
            <i class="fas fa-chevron-left"></i>
          <% end %>
        <% else %>
          <button class="nav-button nav-prev" disabled title="No previous slide">
            <i class="fas fa-chevron-left"></i>
          </button>
        <% end %>

        <% if @has_next %>
          <%= link_to present_instructor_course_lesson_path(@course, @current_lesson, slide: @current_slide + 1), 
                      class: "nav-button nav-next", 
                      title: "Next slide" do %>
            <i class="fas fa-chevron-right"></i>
          <% end %>
        <% else %>
          <button class="nav-button nav-next" disabled title="No next slide">
            <i class="fas fa-chevron-right"></i>
          </button>
        <% end %>

        <!-- Current Slide -->
        <div class="slide">
          <div class="content-block">
            <%= render "instructor/lessons/presentation_content_block", content_block: @current_content_block %>
          </div>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="empty-lesson">
          <i class="fas fa-presentation-screen"></i>
          <h3>No Content to Present</h3>
          <p>This lesson doesn't have any content blocks yet.</p>
          <p>Add some content blocks to start presenting!</p>
        </div>
      <% end %>
    </div>

    <!-- Footer Controls -->
    <div class="presentation-footer">
      <%= link_to instructor_course_lesson_path(@course, @current_lesson), 
                  class: "control-button", 
                  title: "Exit presentation mode" do %>
        <i class="fas fa-times"></i> Exit Presentation
      <% end %>
      
      <% if @total_slides > 1 %>
        <button id="overviewFooterToggle" class="control-button" title="Show slide overview">
          <i class="fas fa-th-large"></i> Overview
        </button>

        <%= link_to present_instructor_course_lesson_path(@course, @current_lesson, slide: 1), 
                    class: "control-button", 
                    title: "Go to first slide" do %>
          <i class="fas fa-step-backward"></i> First
        <% end %>
        
        <%= link_to present_instructor_course_lesson_path(@course, @current_lesson, slide: @total_slides), 
                    class: "control-button", 
                    title: "Go to last slide" do %>
          <i class="fas fa-step-forward"></i> Last
        <% end %>
      <% end %>
    </div>
  </div>

  <script>
    // Initialize presentation mode functionality
    function initializePresentationMode() {
      // Overview Panel Toggle
      const overviewToggle = document.getElementById('overviewToggle');
      const overviewFooterToggle = document.getElementById('overviewFooterToggle');
      const slideOverview = document.getElementById('slideOverview');
      
      function toggleOverview() {
        if (slideOverview) {
          slideOverview.classList.toggle('open');
          const isOpen = slideOverview.classList.contains('open');
          
          if (overviewToggle) {
            overviewToggle.innerHTML = isOpen ? '<i class="fas fa-times"></i>' : '<i class="fas fa-list"></i>';
            overviewToggle.title = isOpen ? 'Close slide overview' : 'Open slide overview';
          }
          
          if (overviewFooterToggle) {
            overviewFooterToggle.innerHTML = isOpen ? '<i class="fas fa-times"></i> Close' : '<i class="fas fa-th-large"></i> Overview';
            overviewFooterToggle.title = isOpen ? 'Close slide overview' : 'Show slide overview';
          }
        }
      }
      
      // Remove any existing event listeners to prevent duplicates
      if (overviewToggle) {
        overviewToggle.removeEventListener('click', toggleOverview);
        overviewToggle.addEventListener('click', toggleOverview);
      }
      
      if (overviewFooterToggle) {
        overviewFooterToggle.removeEventListener('click', toggleOverview);
        overviewFooterToggle.addEventListener('click', toggleOverview);
      }
      
      // Auto-hide overview when clicking outside
      document.removeEventListener('click', handleOutsideClick);
      document.addEventListener('click', handleOutsideClick);
      
      function handleOutsideClick(e) {
        if (slideOverview && slideOverview.classList.contains('open') && 
            !e.target.closest('.slide-overview') && 
            !e.target.closest('.overview-toggle') &&
            !e.target.closest('#overviewFooterToggle')) {
          toggleOverview();
        }
      }
      
      // Store toggleOverview function globally for keyboard events
      window.toggleOverview = toggleOverview;
    }
    
    // Initialize on page load
    document.addEventListener('DOMContentLoaded', initializePresentationMode);
    
    // Also initialize immediately in case DOMContentLoaded already fired
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializePresentationMode);
    } else {
      initializePresentationMode();
    }

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      // Don't trigger navigation if overview is open and user is interacting with it
      if (slideOverview && slideOverview.classList.contains('open') && e.target.closest('.slide-overview')) {
        return;
      }

      switch(e.key) {
        case 'ArrowLeft':
        case 'ArrowUp':
          <% if @has_previous %>
            window.location.href = '<%= present_instructor_course_lesson_path(@course, @current_lesson, slide: @current_slide - 1) %>';
          <% end %>
          break;
        case 'ArrowRight':
        case 'ArrowDown':
        case ' ': // Spacebar
          <% if @has_next %>
            window.location.href = '<%= present_instructor_course_lesson_path(@course, @current_lesson, slide: @current_slide + 1) %>';
          <% end %>
          e.preventDefault();
          break;
        case 'Home':
          window.location.href = '<%= present_instructor_course_lesson_path(@course, @current_lesson, slide: 1) %>';
          break;
        case 'End':
          window.location.href = '<%= present_instructor_course_lesson_path(@course, @current_lesson, slide: @total_slides) %>';
          break;
        case 'Escape':
          const slideOverview = document.getElementById('slideOverview');
          if (slideOverview && slideOverview.classList.contains('open')) {
            if (window.toggleOverview) window.toggleOverview();
          } else {
            window.location.href = '<%= instructor_course_lesson_path(@course, @current_lesson) %>';
          }
          break;
        case 'o':
        case 'O':
          // Toggle overview with 'O' key
          if (window.toggleOverview) window.toggleOverview();
          break;
      }
    });

    // Prevent context menu
    document.addEventListener('contextmenu', e => e.preventDefault());
    
    // Full screen on F11 or double click
    document.addEventListener('dblclick', function() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen();
      }
    });


    console.log('Presentation Mode Active');
    console.log('Navigation: Arrow keys, Space, Home, End, Escape');
    console.log('Overview: O key or click button');
    console.log('Double-click for fullscreen');
  </script>
</body>
</html>