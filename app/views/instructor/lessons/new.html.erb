<% content_for :title, "Add New Lesson" %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <h3>Add New Lesson to "<%= @course.title %>"</h3>
      </div>
      <div class="card-body">
        <%= form_with model: [@course, @lesson], url: instructor_course_lessons_path(@course), local: true do |form| %>
          <% if @lesson.errors.any? %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% @lesson.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3">
            <%= form.label :title, class: "form-label" %>
            <%= form.text_field :title, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= form.label :content, "Initial Content (optional)", class: "form-label" %>
            <%= form.text_area :content, class: "form-control", rows: 4 %>
            <div class="form-text">
              <strong>Optional:</strong> Add some basic content to get started. You'll use Content Blocks for rich, mixed-media content after creating the lesson.
            </div>
          </div>

          <div class="mb-3">
            <%= form.label :position, "Lesson Position", class: "form-label" %>
            <%= form.number_field :position, class: "form-control", min: 1, required: true %>
            <div class="form-text">The order of this lesson in the course (1 = first lesson)</div>
          </div>

          <div class="d-flex justify-content-between">
            <%= link_to "Cancel", instructor_course_lessons_path(@course), class: "btn btn-secondary" %>
            <%= form.submit "Create Lesson", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>