<% content_for :title, @lesson.title %>

<div class="row">
  <div class="col-12">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to "My Courses", instructor_courses_path %></li>
        <li class="breadcrumb-item"><%= link_to @course.title, instructor_course_path(@course) %></li>
        <li class="breadcrumb-item"><%= link_to "Lessons", instructor_course_lessons_path(@course) %></li>
        <li class="breadcrumb-item active" aria-current="page"><%= @lesson.title %></li>
      </ol>
    </nav>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h3><%= @lesson.title %></h3>
            <p class="text-muted mb-0">Lesson <%= @lesson.position %> of <%= @course.lessons.count %></p>
          </div>
          <div>
            <% if @lesson.has_content_blocks? %>
              <%= link_to present_instructor_course_lesson_path(@course, @lesson), 
                          class: "btn btn-success me-2", 
                          title: "Enter presentation mode",
                          target: "_blank" do %>
                <i class="fas fa-tv"></i> Present Mode
              <% end %>
            <% end %>
            <%= link_to "Edit Lesson", edit_instructor_course_lesson_path(@course, @lesson), class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h6>Lesson Content</h6>
          <div>
            <%= link_to "Edit Content Blocks", edit_instructor_course_lesson_path(@course, @lesson), 
                        class: "btn btn-primary btn-sm" %>
          </div>
        </div>

        <% if @lesson.has_content_blocks? %>
          <div class="lesson-content">
            <% @lesson.ordered_content_blocks.each do |content_block| %>
              <%= render "content_blocks/content_block", content_block: content_block %>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-4 text-muted">
            <i class="fas fa-edit fa-2x mb-3"></i>
            <p>No content blocks created yet.</p>
            <p><%= link_to "Start adding content blocks", edit_instructor_course_lesson_path(@course, @lesson), 
                           class: "btn btn-primary btn-sm" %></p>
          </div>
        <% end %>

      </div>
    </div>

    <!-- Assignments Section -->
    <div class="card mt-4">
      <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
          <h5>Assignments</h5>
          <%= link_to new_instructor_course_lesson_assignment_path(@course, @lesson, type: 'quiz'), 
                      class: "btn btn-success btn-sm" do %>
            <i class="fas fa-question-circle"></i> Add Quiz
          <% end %>
        </div>
      </div>
      <div class="card-body">
        <div id="assignments-list">
        <% if @lesson.has_assignments? %>
          <% @lesson.assignments.ordered.each do |assignment| %>
            <div class="assignment-item mb-3 p-3 border rounded">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h6 class="mb-1">
                    <%= link_to assignment.title, 
                                instructor_course_lesson_assignment_path(@course, @lesson, assignment), 
                                class: "text-decoration-none" %>
                    <span class="badge bg-<%= assignment.published? ? 'success' : 'secondary' %> ms-2">
                      <%= assignment.published? ? 'Published' : 'Draft' %>
                    </span>
                  </h6>
                  <p class="text-muted small mb-2"><%= assignment.description %></p>
                  <div class="assignment-meta">
                    <span class="badge bg-light text-dark me-2">
                      <i class="fas fa-<%= assignment.quiz? ? 'question-circle' : assignment.coding? ? 'code' : 'edit' %>"></i>
                      <%= assignment.assignment_type.titleize %>
                    </span>
                    <span class="text-muted small">
                      <i class="fas fa-star"></i> <%= assignment.max_score %> points
                    </span>
                    <% if assignment.due_date.present? %>
                      <span class="text-muted small ms-2">
                        <i class="fas fa-clock"></i> Due <%= assignment.due_date.strftime("%b %d, %Y") %>
                      </span>
                    <% end %>
                  </div>
                </div>
                <div class="assignment-actions">
                  <%= link_to instructor_course_lesson_assignment_path(@course, @lesson, assignment), 
                              class: "btn btn-sm btn-outline-primary" do %>
                    <i class="fas fa-eye"></i> View
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-4 text-muted">
            <i class="fas fa-clipboard-list fa-2x mb-3"></i>
            <p>No assignments created yet.</p>
            <p>Add assignments to test your students' understanding.</p>
          </div>
        <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h6>Lesson Information</h6>
      </div>
      <div class="card-body">
        <p><strong>Position:</strong> <%= @lesson.position %></p>
        <p><strong>Course:</strong> <%= @course.title %></p>
        <p><strong>Created:</strong> <%= @lesson.created_at.strftime("%B %d, %Y") %></p>
        <p><strong>Updated:</strong> <%= @lesson.updated_at.strftime("%B %d, %Y") %></p>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">
        <h6>Student Progress</h6>
      </div>
      <div class="card-body">
        <% completed_students = @lesson.completed_by_users.count %>
        <% total_students = @course.students.count %>
        
        <p><strong>Completed by:</strong> <%= completed_students %> of <%= total_students %> students</p>
        
        <% if total_students > 0 %>
          <div class="progress">
            <div class="progress-bar" role="progressbar" style="width: <%= (completed_students.to_f / total_students * 100).round(1) %>%">
              <%= (completed_students.to_f / total_students * 100).round(1) %>%
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">
        <h6>Actions</h6>
      </div>
      <div class="card-body">
        <%= link_to "Edit Lesson", edit_instructor_course_lesson_path(@course, @lesson), class: "btn btn-primary btn-sm w-100 mb-2" %>
        <%= link_to "Back to Lessons", instructor_course_lessons_path(@course), class: "btn btn-secondary btn-sm w-100 mb-2" %>
        <%= link_to "Delete Lesson", instructor_course_lesson_path(@course, @lesson), method: :delete, 
            confirm: "Are you sure?", class: "btn btn-danger btn-sm w-100" %>
      </div>
    </div>
  </div>
</div>

