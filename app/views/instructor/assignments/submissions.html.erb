<% content_for :title, "Submissions: #{@assignment.title}" %>

<div class="row">
  <div class="col-12">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to "My Courses", instructor_courses_path %></li>
        <li class="breadcrumb-item"><%= link_to @course.title, instructor_course_path(@course) %></li>
        <li class="breadcrumb-item"><%= link_to @lesson.title, instructor_course_lesson_path(@course, @lesson) %></li>
        <li class="breadcrumb-item"><%= link_to @assignment.title, instructor_course_lesson_assignment_path(@course, @lesson, @assignment) %></li>
        <li class="breadcrumb-item active" aria-current="page">Submissions</li>
      </ol>
    </nav>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
          <h5>Student Submissions</h5>
          <div>
            <span class="badge bg-primary me-2"><%= @submission_stats[:total] %> Total</span>
            <span class="badge bg-success me-2"><%= @submission_stats[:graded] %> Graded</span>
            <span class="badge bg-warning"><%= @submission_stats[:pending] %> Pending</span>
          </div>
        </div>
      </div>
      <div class="card-body">
        <% if @submissions.any? %>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Student</th>
                  <th>Status</th>
                  <th>Score</th>
                  <th>Submitted</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @submissions.each do |submission| %>
                  <tr class="<%= 'table-warning' if submission.submitted? && !submission.graded? %>">
                    <td>
                      <div class="d-flex align-items-center">
                        <div>
                          <strong><%= submission.user.name %></strong>
                          <br>
                          <small class="text-muted"><%= submission.user.email %></small>
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="badge bg-<%= submission_status_color(submission) %>">
                        <%= submission.status.titleize %>
                        <% if submission.auto_graded? %>
                          <i class="fas fa-robot ms-1" title="Auto-graded"></i>
                        <% end %>
                      </span>
                      <% if submission.late_submission? %>
                        <br><small class="text-warning"><i class="fas fa-clock"></i> Late</small>
                      <% end %>
                    </td>
                    <td>
                      <% if submission.graded? %>
                        <strong><%= submission.score %>/<%= submission.max_score %></strong>
                        <br>
                        <small class="text-muted">
                          <%= submission.percentage_score %>% 
                          (<%= submission.grade_letter %>)
                        </small>
                      <% else %>
                        <span class="text-muted">Not graded</span>
                      <% end %>
                    </td>
                    <td>
                      <% if submission.submitted_at.present? %>
                        <small>
                          <%= submission.submitted_at.strftime("%b %d, %Y") %>
                          <br>
                          <%= submission.submitted_at.strftime("%I:%M %p") %>
                        </small>
                      <% else %>
                        <span class="text-muted">Draft</span>
                      <% end %>
                    </td>
                    <td>
                      <% if submission.completed? %>
                        <%= link_to "Review", 
                                    instructor_course_lesson_assignment_submission_path(@course, @lesson, @assignment, submission),
                                    class: "btn btn-sm btn-outline-primary" %>
                        <% if submission.submitted? && !submission.graded? %>
                          <span class="badge bg-warning ms-1">Needs Grading</span>
                        <% end %>
                      <% else %>
                        <span class="text-muted small">In progress</span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="text-center py-5 text-muted">
            <i class="fas fa-clipboard-list fa-3x mb-3"></i>
            <h6>No Submissions Yet</h6>
            <p>Students haven't started working on this assignment yet.</p>
            <% unless @assignment.published? %>
              <div class="alert alert-info">
                <i class="fas fa-info-circle"></i>
                This assignment is not published yet. Students won't see it until you publish it.
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <!-- Quick Stats -->
    <div class="card">
      <div class="card-header">
        <h6>Grading Overview</h6>
      </div>
      <div class="card-body">
        <div class="stat-item mb-3">
          <div class="d-flex justify-content-between">
            <span>Total Submissions:</span>
            <strong><%= @submission_stats[:total] %></strong>
          </div>
        </div>
        <div class="stat-item mb-3">
          <div class="d-flex justify-content-between">
            <span>Completed:</span>
            <strong><%= @submission_stats[:submitted] %></strong>
          </div>
        </div>
        <div class="stat-item mb-3">
          <div class="d-flex justify-content-between">
            <span>Graded:</span>
            <strong class="text-success"><%= @submission_stats[:graded] %></strong>
          </div>
        </div>
        <div class="stat-item mb-3">
          <div class="d-flex justify-content-between">
            <span>Pending Grading:</span>
            <strong class="text-warning"><%= @submission_stats[:pending] %></strong>
          </div>
        </div>
        
        <% if @submission_stats[:pending] > 0 %>
          <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            You have <strong><%= @submission_stats[:pending] %></strong> 
            <%= @submission_stats[:pending] == 1 ? 'submission' : 'submissions' %> 
            waiting for manual grading.
          </div>
        <% end %>
      </div>
    </div>

    <!-- Assignment Info -->
    <div class="card mt-3">
      <div class="card-header">
        <h6>Assignment Details</h6>
      </div>
      <div class="card-body">
        <p><strong>Type:</strong> <%= @assignment.assignment_type.titleize %></p>
        <p><strong>Max Score:</strong> <%= @assignment.max_score %> points</p>
        <p><strong>Questions:</strong> <%= @assignment.assignment_questions.count %></p>
        <% if @assignment.due_date.present? %>
          <p>
            <strong>Due Date:</strong> 
            <%= @assignment.due_date.strftime("%b %d, %Y at %I:%M %p") %>
            <% if @assignment.overdue? %>
              <br><small class="text-danger">Past due</small>
            <% end %>
          </p>
        <% end %>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="card mt-3">
      <div class="card-header">
        <h6>Actions</h6>
      </div>
      <div class="card-body">
        <%= link_to "Back to Assignment", 
                    instructor_course_lesson_assignment_path(@course, @lesson, @assignment), 
                    class: "btn btn-secondary w-100 mb-2" %>
        <%= link_to "Export Results", "#", 
                    class: "btn btn-outline-success w-100 mb-2",
                    onclick: "alert('Export feature coming soon!')" %>
      </div>
    </div>
  </div>
</div>