<% content_for :title, @assignment.title %>

<div class="row">
  <div class="col-12">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to "My Courses", instructor_courses_path %></li>
        <li class="breadcrumb-item"><%= link_to @course.title, instructor_course_path(@course) %></li>
        <li class="breadcrumb-item"><%= link_to "Lessons", instructor_course_lessons_path(@course) %></li>
        <li class="breadcrumb-item"><%= link_to @lesson.title, instructor_course_lesson_path(@course, @lesson) %></li>
        <li class="breadcrumb-item active" aria-current="page"><%= @assignment.title %></li>
      </ol>
    </nav>
  </div>
</div>

<!-- Flash Messages Container for Turbo Stream Updates -->
<div id="flash-messages"></div>

<div class="row">
  <div class="col-md-8">
    <!-- Assignment Overview -->
    <div class="card">
      <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h4><%= @assignment.title %></h4>
            <span class="badge bg-<%= @assignment.published? ? 'success' : 'secondary' %> me-2">
              <%= @assignment.published? ? 'Published' : 'Draft' %>
            </span>
            <span class="badge bg-<%= @assignment.quiz? ? 'primary' : @assignment.coding? ? 'success' : 'warning' %>">
              <%= @assignment.assignment_type.titleize %>
            </span>
          </div>
          <div>
            <%= link_to "Edit Assignment", 
                        edit_instructor_course_lesson_assignment_path(@course, @lesson, @assignment), 
                        class: "btn btn-outline-primary btn-sm" %>
            <%= link_to (@assignment.published? ? "Unpublish" : "Publish"), 
                        instructor_course_lesson_assignment_path(@course, @lesson, @assignment, publish: true), 
                        method: :patch,
                        class: "btn btn-#{@assignment.published? ? 'warning' : 'success'} btn-sm",
                        data: { confirm: "Are you sure?" } %>
          </div>
        </div>
      </div>
      <div class="card-body">
        <% if @assignment.description.present? %>
          <p class="text-muted"><%= @assignment.description %></p>
        <% end %>
        
        <div class="row mb-3">
          <div class="col-md-3">
            <strong>Max Score:</strong> <%= @assignment.max_score %> points
          </div>
          <div class="col-md-3">
            <strong>Questions:</strong> <%= @assignment.total_questions %>
          </div>
          <div class="col-md-3">
            <strong>Average Score:</strong> <%= @assignment.average_score %>%
          </div>
          <div class="col-md-3">
            <strong>Completion:</strong> <%= @assignment.completion_rate %>%
          </div>
        </div>

        <% if @assignment.due_date.present? %>
          <p><strong>Due Date:</strong> <%= @assignment.due_date.strftime("%B %d, %Y at %I:%M %p") %></p>
        <% end %>

        <% if @assignment.instructions.present? %>
          <div class="mt-3">
            <strong>Instructions for Students:</strong>
            <div class="mt-2 p-3 bg-light rounded">
              <%= simple_format(@assignment.instructions) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Questions Section -->
    <div class="card mt-4">
      <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
          <h5>Assignment Questions</h5>
          <div class="dropdown">
            <button class="btn btn-success btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
              <i class="fas fa-plus"></i> Add Question
            </button>
            <ul class="dropdown-menu">
              <li><%= link_to new_instructor_course_lesson_assignment_assignment_question_path(@course, @lesson, @assignment, type: 'multiple_choice'), 
                              class: "dropdown-item" do %>
                      <i class="fas fa-list text-primary"></i> Multiple Choice
                  <% end %></li>
              <li><%= link_to new_instructor_course_lesson_assignment_assignment_question_path(@course, @lesson, @assignment, type: 'true_false'), 
                              class: "dropdown-item" do %>
                      <i class="fas fa-check-circle text-success"></i> True/False
                  <% end %></li>
              <li><%= link_to new_instructor_course_lesson_assignment_assignment_question_path(@course, @lesson, @assignment, type: 'coding'), 
                              class: "dropdown-item" do %>
                      <i class="fas fa-code text-warning"></i> Coding Question
                  <% end %></li>
              <li><%= link_to new_instructor_course_lesson_assignment_assignment_question_path(@course, @lesson, @assignment, type: 'essay'), 
                              class: "dropdown-item" do %>
                      <i class="fas fa-edit text-info"></i> Essay Question
                  <% end %></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="card-body">
        <% if @assignment.assignment_questions.any? %>
          <div id="questions-container">
            <% @assignment.assignment_questions.ordered.each_with_index do |question, index| %>
              <div class="question-item mb-4 p-3 border rounded">
                <div class="d-flex justify-content-between align-items-start">
                  <div class="flex-grow-1">
                    <div class="question-header mb-2">
                      <strong>Question <%= index + 1 %></strong>
                      <span class="badge bg-light text-dark ms-2">
                        <%= question.question_type.titleize %>
                      </span>
                      <span class="badge bg-info ms-2">
                        <%= question.points %> points
                      </span>
                    </div>
                    <div class="question-text mb-3">
                      <%= simple_format(question.question_text) %>
                    </div>
                    
                    <% if question.multiple_choice? && question.options.present? %>
                      <div class="question-options">
                        <small class="text-muted">Answer Choices:</small>
                        <ul class="list-unstyled ms-3">
                          <% question.option_labels.each do |option| %>
                            <li class="<%= option.starts_with?(question.correct_option_label&.first) ? 'text-success fw-bold' : '' %>">
                              <%= option %>
                              <% if option.starts_with?(question.correct_option_label&.first) %>
                                <i class="fas fa-check text-success ms-1"></i>
                              <% end %>
                            </li>
                          <% end %>
                        </ul>
                      </div>
                    <% elsif question.true_false? %>
                      <div class="question-options">
                        <small class="text-muted">Correct Answer: 
                          <strong class="text-success">
                            <%= question.correct_answer == "1" ? "True" : "False" %>
                          </strong>
                        </small>
                      </div>
                    <% elsif question.coding? && question.correct_answer.present? %>
                      <div class="question-options">
                        <small class="text-muted">Expected Code/Keywords:</small>
                        <pre class="bg-light p-2 mt-1 small"><%= question.correct_answer %></pre>
                      </div>
                    <% end %>
                  </div>
                  <div class="question-actions">
                    <%= link_to edit_instructor_course_lesson_assignment_assignment_question_path(@course, @lesson, @assignment, question), 
                                class: "btn btn-sm btn-outline-primary" do %>
                      <i class="fas fa-edit"></i>
                    <% end %>
                    <%= link_to instructor_course_lesson_assignment_assignment_question_path(@course, @lesson, @assignment, question), 
                                method: :delete, 
                                confirm: "Are you sure you want to delete this question?",
                                class: "btn btn-sm btn-outline-danger ms-1" do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-5 text-muted">
            <i class="fas fa-question-circle fa-3x mb-3"></i>
            <h6>No Questions Added Yet</h6>
            <p>Add questions to make this assignment functional for students.</p>
            <div class="mt-3">
              <%= link_to new_instructor_course_lesson_assignment_assignment_question_path(@course, @lesson, @assignment, type: 'multiple_choice'), 
                          class: "btn btn-primary btn-sm me-2" do %>
                <i class="fas fa-plus"></i> Add First Question
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Preview Section -->
    <% if @assignment.assignment_questions.any? %>
      <div class="card mt-4">
        <div class="card-header">
          <h6>Student Preview</h6>
        </div>
        <div class="card-body">
          <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            This is how students will see the assignment:
          </div>
          
          <div class="student-preview p-3 border rounded bg-light">
            <h5><%= @assignment.title %></h5>
            <% if @assignment.instructions.present? %>
              <div class="mb-3">
                <%= simple_format(@assignment.instructions) %>
              </div>
            <% end %>
            <p class="text-muted">
              <strong>Points:</strong> <%= @assignment.max_score %> | 
              <strong>Questions:</strong> <%= @assignment.total_questions %> |
              <strong>Type:</strong> <%= @assignment.assignment_type.titleize %>
            </p>
            <button class="btn btn-success btn-sm" disabled>Take Assignment</button>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-md-4">
    <!-- Assignment Stats -->
    <div class="card">
      <div class="card-header">
        <h6>Assignment Statistics</h6>
      </div>
      <div class="card-body">
        <div class="stat-item mb-3">
          <div class="d-flex justify-content-between">
            <span>Total Submissions:</span>
            <strong><%= @stats[:total_submissions] %></strong>
          </div>
        </div>
        <div class="stat-item mb-3">
          <div class="d-flex justify-content-between">
            <span>Completed:</span>
            <strong><%= @stats[:completed_submissions] %></strong>
          </div>
        </div>
        <div class="stat-item mb-3">
          <div class="d-flex justify-content-between">
            <span>Average Score:</span>
            <strong><%= @stats[:average_score] %>%</strong>
          </div>
        </div>
        <div class="stat-item">
          <div class="d-flex justify-content-between">
            <span>Completion Rate:</span>
            <strong><%= @stats[:completion_rate] %>%</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="card mt-3">
      <div class="card-header">
        <h6>Quick Actions</h6>
      </div>
      <div class="card-body">
        <%= link_to "View Submissions", 
                    submissions_instructor_course_lesson_assignment_path(@course, @lesson, @assignment), 
                    class: "btn btn-outline-primary w-100 mb-2" %>
        <%= link_to "Edit Assignment", 
                    edit_instructor_course_lesson_assignment_path(@course, @lesson, @assignment), 
                    class: "btn btn-outline-secondary w-100 mb-2" %>
        <% if @assignment.published? %>
          <%= link_to "View as Student", 
                      student_course_lesson_assignment_path(@course, @lesson, @assignment), 
                      class: "btn btn-outline-info w-100 mb-2", 
                      target: "_blank" %>
        <% end %>
        <%= link_to "Back to Lesson", 
                    instructor_course_lesson_path(@course, @lesson), 
                    class: "btn btn-secondary w-100" %>
      </div>
    </div>

    <!-- Status Indicators -->
    <div class="card mt-3">
      <div class="card-header">
        <h6>Status Checklist</h6>
      </div>
      <div class="card-body">
        <div class="checklist">
          <div class="checklist-item mb-2">
            <i class="fas fa-check-circle text-success"></i>
            <span class="ms-2">Assignment created</span>
          </div>
          <div class="checklist-item mb-2">
            <i class="fas fa-<%= @assignment.assignment_questions.any? ? 'check-circle text-success' : 'circle text-muted' %>"></i>
            <span class="ms-2">Questions added (<%= @assignment.total_questions %>)</span>
          </div>
          <div class="checklist-item mb-2">
            <i class="fas fa-<%= @assignment.published? ? 'check-circle text-success' : 'circle text-muted' %>"></i>
            <span class="ms-2">Published for students</span>
          </div>
          <div class="checklist-item">
            <i class="fas fa-<%= @stats[:total_submissions] > 0 ? 'check-circle text-success' : 'circle text-muted' %>"></i>
            <span class="ms-2">Student submissions received</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>