<% content_for :title, "Add Question" %>

<div class="row">
  <div class="col-12">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to "My Courses", instructor_courses_path %></li>
        <li class="breadcrumb-item"><%= link_to @course.title, instructor_course_path(@course) %></li>
        <li class="breadcrumb-item"><%= link_to "Lessons", instructor_course_lessons_path(@course) %></li>
        <li class="breadcrumb-item"><%= link_to @lesson.title, instructor_course_lesson_path(@course, @lesson) %></li>
        <li class="breadcrumb-item"><%= link_to @assignment.title, instructor_course_lesson_assignment_path(@course, @lesson, @assignment) %></li>
        <li class="breadcrumb-item active" aria-current="page">Add Question</li>
      </ol>
    </nav>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <h4>Add New Question</h4>
            <p class="text-muted mb-0">
              <i class="fas fa-<%= @question.multiple_choice? ? 'list' : @question.true_false? ? 'check-circle' : @question.coding? ? 'code' : 'edit' %>"></i>
              <%= @question.question_type.titleize %>
              <% if @assignment.quiz? %>
                <span class="badge bg-success ms-2">Auto-Graded</span>
              <% end %>
            </p>
          </div>
          <div class="text-end">
            <small class="text-muted">
              <strong><%= @assignment.title %></strong><br>
              Current Questions: <%= @assignment.assignment_questions.count %>
            </small>
          </div>
        </div>
      </div>
      <div class="card-body">
        <!-- Success Message -->
        <% if notice %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i>
            <%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>

        <%= form_with model: [@course, @lesson, @assignment, @question], 
                      url: instructor_course_lesson_assignment_assignment_questions_path(@course, @lesson, @assignment), 
                      local: true,
                      id: "new_assignment_question",
                      class: "needs-validation",
                      novalidate: true do |form| %>
          
          <% if @question.errors.any? %>
            <div class="alert alert-danger alert-dismissible fade show">
              <i class="fas fa-exclamation-triangle"></i>
              <strong>Please fix the following errors:</strong>
              <ul class="mb-0 mt-2">
                <% @question.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>

          <% if @allowed_question_types.length > 1 %>
            <div class="mb-3">
              <%= form.label :question_type, "Question Type", class: "form-label" %>
              <%= form.select :question_type, 
                              options_for_select(
                                @allowed_question_types.map { |type| [type.titleize, type] },
                                @question.question_type
                              ),
                              {},
                              { class: "form-select", onchange: "location.href = this.form.action + '/new?type=' + this.value" } %>
              <% if @assignment.quiz? %>
                <small class="form-text text-success">
                  <i class="fas fa-check-circle"></i> These question types support automatic grading
                </small>
              <% end %>
            </div>
          <% else %>
            <%= form.hidden_field :question_type, value: @question.question_type %>
          <% end %>

          <!-- Hidden field for correct answer (will be set by JavaScript for multiple choice) -->
          <%= form.hidden_field :correct_answer, value: (@question.correct_answer || "0") %>

          <div class="mb-3">
            <%= form.label :question_text, "Question", class: "form-label" %>
            <%= form.text_area :question_text, class: "form-control", rows: 4, required: true,
                               placeholder: "Enter your question here..." %>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <%= form.label :points, "Points", class: "form-label" %>
                <%= form.number_field :points, class: "form-control", min: 1, value: 10 %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <%= form.label :position, "Position", class: "form-label" %>
                <%= form.number_field :position, class: "form-control", min: 1, 
                                      value: (@assignment.assignment_questions.count + 1) %>
              </div>
            </div>
          </div>

          <!-- Multiple Choice Options -->
          <% if @question.multiple_choice? %>
            <div class="mb-4">
              <label class="form-label">Answer Choices</label>
              <div id="choices-container">
                <% 4.times do |i| %>
                  <div class="choice-item mb-2">
                    <div class="input-group">
                      <span class="input-group-text">
                        <input type="radio" name="correct_choice" value="<%= i %>" 
                               <%= 'checked' if i == 0 %> aria-label="Mark as correct answer">
                      </span>
                      <span class="input-group-text"><%= ('A'.ord + i).chr %></span>
                      <input type="text" name="assignment_question[choices][]" 
                             class="form-control" placeholder="Enter choice <%= ('A'.ord + i).chr %>"
                             <%= 'required' if i < 2 %>>
                    </div>
                  </div>
                <% end %>
              </div>
              <small class="form-text text-muted">
                <i class="fas fa-info-circle"></i>
                <strong>Click the radio button (○)</strong> next to the correct answer choice. 
                Fill in at least 2 answer choices. The first option (A) is selected as correct by default.
              </small>
            </div>
          <% end %>

          <!-- True/False -->
          <% if @question.true_false? %>
            <div class="mb-3">
              <%= form.label :correct_answer, "Correct Answer", class: "form-label" %>
              <%= form.select :correct_answer, 
                              options_for_select([['True', '1'], ['False', '0']], '1'), 
                              {}, 
                              { class: "form-select" } %>
            </div>
          <% end %>

          <!-- Coding Question -->
          <% if @question.coding? %>
            <div class="mb-3">
              <%= form.label :correct_answer, "Expected Code/Keywords", class: "form-label" %>
              <%= form.text_area :correct_answer, class: "form-control", rows: 6,
                                 placeholder: "Enter expected code solution or keywords to check for..." %>
              <small class="form-text text-muted">
                For automatic grading, list keywords or code patterns separated by commas.
              </small>
            </div>
          <% end %>

          <!-- Essay Question -->
          <% if @question.essay? %>
            <div class="alert alert-info">
              <i class="fas fa-info-circle"></i>
              <strong>Essay questions require manual grading.</strong>
              Students will submit text responses that you'll need to grade individually.
            </div>
          <% end %>

          <!-- Explanation (Optional) -->
          <div class="mb-3">
            <%= form.label :explanation, "Explanation (Optional)", class: "form-label" %>
            <%= form.text_area :explanation, class: "form-control", rows: 3,
                               placeholder: "Provide explanation to help students understand the correct answer..." %>
            <small class="form-text text-muted">
              This explanation will be shown to students after they submit their answer.
            </small>
          </div>

          <div class="d-flex justify-content-between align-items-center">
            <%= link_to "← Back to Assignment", instructor_course_lesson_assignment_path(@course, @lesson, @assignment), 
                        class: "btn btn-outline-secondary" %>
            <div class="btn-group" role="group">
              <%= form.submit "Add Question", 
                              name: "commit", 
                              value: "Add Question",
                              class: "btn btn-primary",
                              title: "Add question and return to assignment page",
                              data: { disable_with: "<i class='fas fa-spinner fa-spin'></i> Adding..." } %>
              <%= form.submit "Add & Create Another", 
                              name: "commit", 
                              value: "Add & Create Another",
                              class: "btn btn-success",
                              title: "Add question and create another one",
                              data: { disable_with: "<i class='fas fa-spinner fa-spin'></i> Adding..." } %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card">
      <div class="card-header">
        <h6>Question Type Guide</h6>
      </div>
      <div class="card-body">
        <% case @question.question_type %>
        <% when 'multiple_choice' %>
          <div class="question-type-guide">
            <h6><i class="fas fa-list text-primary"></i> Multiple Choice</h6>
            <ul class="small">
              <li>Automatically graded</li>
              <li>2-4 answer choices</li>
              <li>Only one correct answer</li>
              <li>Perfect for factual questions</li>
            </ul>
          </div>
        <% when 'true_false' %>
          <div class="question-type-guide">
            <h6><i class="fas fa-check-circle text-success"></i> True/False</h6>
            <ul class="small">
              <li>Automatically graded</li>
              <li>Simple true or false answer</li>
              <li>Great for concept verification</li>
              <li>Quick to answer</li>
            </ul>
          </div>
        <% when 'coding' %>
          <div class="question-type-guide">
            <h6><i class="fas fa-code text-warning"></i> Coding Question</h6>
            <ul class="small">
              <li>Semi-automatic grading</li>
              <li>Students submit code</li>
              <li>Keywords/patterns checked</li>
              <li>May need manual review</li>
            </ul>
          </div>
        <% when 'essay' %>
          <div class="question-type-guide">
            <h6><i class="fas fa-edit text-info"></i> Essay Question</h6>
            <ul class="small">
              <li>Manual grading required</li>
              <li>Open-ended responses</li>
              <li>Longer text answers</li>
              <li>Critical thinking assessment</li>
            </ul>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">
        <h6>Current Questions</h6>
      </div>
      <div class="card-body">
        <% if @assignment.assignment_questions.any? %>
          <div class="list-group list-group-flush">
            <% @assignment.assignment_questions.ordered.each_with_index do |existing_question, index| %>
              <div class="list-group-item p-2">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <small class="fw-bold">Q<%= index + 1 %></small>
                    <span class="badge bg-light text-dark ms-1">
                      <%= existing_question.question_type.titleize %>
                    </span>
                    <span class="badge bg-info ms-1"><%= existing_question.points %>pts</span>
                  </div>
                  <small class="text-muted">
                    <%= link_to edit_instructor_course_lesson_assignment_assignment_question_path(@course, @lesson, @assignment, existing_question), 
                                class: "text-decoration-none" do %>
                      <i class="fas fa-edit"></i>
                    <% end %>
                  </small>
                </div>
                <div class="mt-1">
                  <small class="text-muted">
                    <%= truncate(existing_question.question_text, length: 50) %>
                  </small>
                </div>
              </div>
            <% end %>
          </div>
          <div class="mt-3 text-center">
            <small class="text-muted">
              <strong><%= @assignment.assignment_questions.count %></strong> question<%= 's' if @assignment.assignment_questions.count != 1 %> 
              (<strong><%= @assignment.max_score %></strong> points total)
            </small>
          </div>
        <% else %>
          <p class="text-muted text-center">
            <i class="fas fa-info-circle"></i><br>
            This will be your first question!
          </p>
        <% end %>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">
        <h6>Assignment Progress</h6>
      </div>
      <div class="card-body">
        <div class="progress-step mb-2">
          <i class="fas fa-check-circle text-success"></i>
          <span class="ms-2">Assignment created</span>
        </div>
        <div class="progress-step mb-2">
          <i class="fas fa-<%= @assignment.assignment_questions.any? ? 'check-circle text-success' : 'clock text-primary' %>"></i>
          <span class="ms-2">Adding questions (<%= @assignment.total_questions %>)</span>
        </div>
        <div class="progress-step mb-2">
          <i class="fas fa-<%= @assignment.assignment_questions.any? ? 'eye text-primary' : 'circle text-muted' %>"></i>
          <span class="ms-2">Preview & test</span>
        </div>
        <div class="progress-step">
          <i class="fas fa-<%= @assignment.published? ? 'check-circle text-success' : 'circle text-muted' %>"></i>
          <span class="ms-2">Publish to students</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Question form initialization - handles both page load and Turbo navigation
function initializeQuestionForm() {
  console.log('Initializing question form...');
  
  // Initialize correct answer selection for multiple choice
  initializeCorrectAnswerSelection();
  
  // Initialize form submission handling
  initializeFormSubmission();
}

function initializeCorrectAnswerSelection() {
  const correctRadios = document.querySelectorAll('input[name="correct_choice"]');
  const correctAnswerField = document.querySelector('input[name="assignment_question[correct_answer]"]');
  
  if (correctRadios.length > 0 && correctAnswerField) {
    console.log('Setting up correct answer selection for', correctRadios.length, 'radio buttons');
    
    // Remove existing event listeners to prevent duplicates
    correctRadios.forEach((radio, index) => {
      // Clone the radio to remove all event listeners
      const newRadio = radio.cloneNode(true);
      radio.parentNode.replaceChild(newRadio, radio);
      
      // Add fresh event listener
      newRadio.addEventListener('change', function() {
        if (this.checked) {
          correctAnswerField.value = index.toString();
          console.log('Correct answer set to choice', index);
        }
      });
    });
    
    // Set initial value based on checked radio button
    const checkedRadio = document.querySelector('input[name="correct_choice"]:checked');
    if (checkedRadio) {
      correctAnswerField.value = checkedRadio.value;
    }
    
    console.log('✓ Correct answer selection initialized. Current value:', correctAnswerField.value);
  }
}

function initializeFormSubmission() {
  const form = document.querySelector('#new_assignment_question, form[action*="assignment_questions"]');
  const submitButtons = document.querySelectorAll('input[type="submit"], button[type="submit"]');
  
  if (form) {
    console.log('✓ Form found:', form.id || 'unnamed form');
    console.log('✓ Submit buttons found:', submitButtons.length);
    
    // Ensure form can be submitted
    form.addEventListener('submit', function(e) {
      console.log('Form submit event triggered');
      
      // Disable submit buttons to prevent double submission
      submitButtons.forEach(button => {
        button.disabled = true;
        const originalText = button.value || button.textContent;
        if (button.dataset.disableWith) {
          button.innerHTML = button.dataset.disableWith;
        }
        
        // Re-enable after a delay in case of validation errors
        setTimeout(() => {
          if (button.disabled) {
            button.disabled = false;
            button.innerHTML = originalText;
          }
        }, 5000);
      });
    });
    
    // Add click handlers for submit buttons
    submitButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        console.log('Submit button clicked:', this.value || this.textContent);
        
        // Validate form if it's a multiple choice question
        const questionType = document.querySelector('input[name="assignment_question[question_type]"]')?.value;
        if (questionType === 'multiple_choice') {
          const questionText = document.querySelector('input[name="assignment_question[question_text]"], textarea[name="assignment_question[question_text]"]')?.value;
          const choices = document.querySelectorAll('input[name="assignment_question[choices][]"]');
          const filledChoices = Array.from(choices).filter(choice => choice.value.trim() !== '');
          
          if (!questionText || questionText.trim().length < 10) {
            alert('Please enter a question with at least 10 characters.');
            e.preventDefault();
            return false;
          }
          
          if (filledChoices.length < 2) {
            alert('Please provide at least 2 answer choices.');
            e.preventDefault();
            return false;
          }
        }
      });
    });
  } else {
    console.warn('⚠ Form not found - buttons may not work');
  }
}

// Initialize on both DOMContentLoaded and Turbo events
document.addEventListener('DOMContentLoaded', initializeQuestionForm);
document.addEventListener('turbo:load', initializeQuestionForm);
document.addEventListener('turbo:render', initializeQuestionForm);

// Clean up on navigation
document.addEventListener('turbo:before-visit', function() {
  console.log('Turbo navigation starting - cleaning up...');
});
</script>