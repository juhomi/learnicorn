<div class="content-block-item" data-content-block-id="<%= content_block.id %>" data-position="<%= content_block.position %>">
  <div class="content-block-header">
    <div class="d-flex justify-content-between align-items-center">
      <div class="drag-handle-container">
        <div class="drag-handle">
          <i class="fas fa-grip-lines text-muted"></i>
        </div>
        <div class="content-block-meta">
          <span class="content-type-badge content-type-<%= content_block.block_type %>">
            <i class="fas fa-<%= content_block.block_type == 'text' ? 'font' : content_block.block_type == 'image' ? 'image' : 'video' %>"></i>
            <%= content_block.block_type.titleize %>
          </span>
          <span class="position-indicator">#<%= content_block.position %></span>
        </div>
      </div>
      <div class="content-block-actions">
        <%= link_to edit_instructor_course_lesson_content_block_path(@course, @lesson, content_block), 
            class: "action-btn edit-btn", 
            data: { turbo_frame: "content_block_form" }, 
            title: "Edit content block" do %>
          <i class="fas fa-edit"></i>
        <% end %>
        <%= link_to instructor_course_lesson_content_block_path(@course, @lesson, content_block), 
            method: :delete, 
            confirm: "Are you sure you want to delete this content block?", 
            class: "action-btn delete-btn",
            data: { turbo_method: :delete },
            title: "Delete content block" do %>
          <i class="fas fa-trash"></i>
        <% end %>
      </div>
    </div>
  </div>
  
  <div class="content-block-preview">
    <%= render "instructor/content_blocks/#{content_block.block_type}_display", content_block: content_block %>
  </div>
</div>