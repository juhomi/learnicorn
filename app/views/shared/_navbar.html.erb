<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container-fluid">
    <%= link_to "LMS", root_path, class: "navbar-brand" %>
    
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <% if current_user.admin? %>
          <li class="nav-item">
            <%= link_to "Admin Dashboard", admin_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Users", admin_users_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Courses", admin_courses_path, class: "nav-link" %>
          </li>
        <% elsif current_user.instructor? %>
          <li class="nav-item">
            <%= link_to "Dashboard", instructor_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "My Courses", instructor_courses_path, class: "nav-link" %>
          </li>
        <% elsif current_user.student? %>
          <li class="nav-item">
            <%= link_to "Dashboard", student_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Browse Courses", courses_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "My Courses", student_courses_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
      
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
            <%= current_user.name %> (<%= current_user.role.titleize %>)
          </a>
          <ul class="dropdown-menu">
            <li>
              <%= form_with url: logout_path, method: :delete, local: true, class: "d-inline" do %>
                <%= submit_tag "Logout", class: "dropdown-item border-0 bg-transparent text-start w-100", style: "cursor: pointer;" %>
              <% end %>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>