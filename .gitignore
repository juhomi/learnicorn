
# ClaudeOnRails
.claude-on-rails/sessions/
.claude-swarm/
claude-swarm.log

# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore precompiled assets.
/public/assets
/public/packs
/public/packs-test
/public/vite*

# Ignore yarn files
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore node_modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore uploaded files in development
/public/uploads

# Ignore coverage reports
/coverage

# Ignore byebug command history file.
.byebug_history

# Ignore Spring files.
/spring/*.pid

# Ignore Vim swap files
*.swp
*.swo

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore Vagrant files
.vagrant/

# Ignore IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore environment files
.env
.env.local
.env.*.local

# Ignore LMS-specific files
/public/courses/**
/public/assignments/**
/public/submissions/**
!/public/courses/.keep
!/public/assignments/.keep
!/public/submissions/.keep

# Ignore generated certificates and keys
*.pem
*.key
*.crt

# Ignore Redis dump files
dump.rdb

# Ignore Elasticsearch data
/elasticsearch/

# Ignore test artifacts
/tmp/screenshots/
