# Database Configuration
# Development Environment
DATABASE_NAME=learning_dev_db
DATABASE_USERNAME=learning_dev_user
DATABASE_PASSWORD=your_development_password
DATABASE_HOST=localhost

# Test Environment
TEST_DATABASE_NAME=learning_test_db
TEST_DATABASE_USERNAME=learning_test_user
TEST_DATABASE_PASSWORD=your_test_password
TEST_DATABASE_HOST=localhost

# Production Environment
PRODUCTION_DATABASE_NAME=learning_production_db
PRODUCTION_DATABASE_USERNAME=learning_production_user
PRODUCTION_DATABASE_PASSWORD=your_production_password
PRODUCTION_DATABASE_HOST=your_production_host

# Production Multiple Databases
PRODUCTION_CACHE_DATABASE_NAME=learning_production_cache
PRODUCTION_QUEUE_DATABASE_NAME=learning_production_queue
PRODUCTION_CABLE_DATABASE_NAME=learning_production_cable

# Rails Configuration
RAILS_MAX_THREADS=5